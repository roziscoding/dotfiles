[tools]
bun = "latest"
node = "latest"
deno = "latest"
github-cli = "latest"
jq = "latest"
"npm:pino-pretty" = "latest"
aws-cli = { version = "latest", symlink_bins = "true" }
kubectl = "latest"
"npm:agent-browser" = "latest"
act = "latest"
pulumi = "latest"
"aqua:neovim/neovim" = "latest"
starship = "latest"
atuin = "latest"
bat = "latest"
caddy = "latest"
chezmoi = "latest"
cloudflared = "latest"
cmake = "latest"
coreutils = "latest"
direnv = "latest"
eza = "latest"
fzf = "latest"
hyperfine = "latest"
k9s = "latest"
lazyjournal = "latest"
zoxide = "latest"
xh = "latest"
yazi = "latest"
python = "latest"
ripgrep = "latest"
sqlite = "latest"
infisical = "latest"
age = "latest"
claude = "latest"
helm = "latest"
argocd = "latest"
"npm:ccstatusline" = "latest"
go = "latest"
"npm:greptile" = "latest"
#codex = "latest"
tmux = "latest"
"npm:ctx7" = "latest"
usage = "latest"
"github:meistrari/pantry-cli" = "latest"
vault = "latest"
"npm:skills" = "latest"
codex = "latest"

[env]
DOCKER_HOST = ""
EDITOR = "nvim"
LANG = "en_US.UTF-8"
LC_ALL = "en_US.UTF-8"
PNPM_HOME = "{{ "{{env.HOME}}" }}/pnpm"
TESTCONTAINERS_RYUK_DISABLED = "true"
PAGER = "bat"
{{- if eq .chezmoi.os "linux" }}
ELECTRON_OZONE_PLATFORM_HINT = "auto"
SYSTEMD_COLORS = "false"
SYSTEMD_PAGERSECURE = "true"
SYSTEMD_PAGER = "bat -l syslog -p"
{{- end }}

[settings]
color = true
idiomatic_version_file_enable_tools = ["node"]
minimum_release_age = "0"
experimental = true

[settings.npm]
package_manager = "bun"

[settings.github]
credential_command = "gh auth token"

[shell_alias]
m = "mise"
als = 'atuin dotfiles alias set'
at = 'atuin'
cat = 'bat'
claudio = 'claude --dangerously-skip-permissions'
cm = 'chezmoi'
cme = 'cm edit --watch'
createdb = 'docker run --rm -it --network=host postgres createdb'
db = 'devbox'
dbr = 'devbox run'
dc = 'docker compose'
g = 'git'
ga = 'git add'
gaa = 'git add .'
gap = 'git add -p'
gb = 'git branch'
gco = 'git switch'
ghc = '_(){ dest=$(command ghc $1) && cd $dest }; _'
gpl = 'git pull'
gps = 'git push'
ht = 'xhs'
http = 'xhs'
k = 'kubectl'
mkd = '_(){ mkdir $1 && cd $1 }; _'
mkpr = 'gh pr create -a @me -f -B dev'
mongo = 'docker exec -it mongodb mongo'
nodeclear = 'find . -name "node_modules" -type d -prune -exec rm -rf "{}" + && rm -f ./pnpm-lock.yaml'
p = 'pulumi'
pk = 'pakku-mc'
psql = 'docker run --rm -it --network=host postgres psql'
pup = 'pulumi up'
spt = 'spotify_player'
l1 = 'ls -1'
l1a = 'ls -1a'
tmx = "tmux new"
tmxl = "tmux ls"
tmxn = "_(){ screen -S $1 -t $1 }; _"
claude = "claude --allow-dangerously-skip-permissions"
{{- if eq .chezmoi.os "linux" }}
pbcopy = 'xclip -selection clipboard -in'
randomwall = 'wal -i $(find ~/Pictures/Wallpapers -type f | shuf -n 1) && walogram'
unlock = 'pkill -USR1 hyprlock'
yayy = 'yay --noconfirm'
fp = 'flatpak'
flms = "flameshot"
dfh = "df --exclude-type tmpfs --exclude-type vfat --exclude-type efivarfs --exclude-type devtmpfs -h"
{{- end }}

[bootstrap.repos]
"~/.local/share/zinit/zinit.git" = { url = "https://github.com/zdharma-continuum/zinit.git" }
{{- if eq .chezmoi.os "linux" }}

[bootstrap.packages]
"pacman:hyprland" = "latest"
"pacman:hyprlock" = "latest"
"pacman:ghostty" = "latest"
"pacman:nautilus" = "latest"
"pacman:openrgb" = "latest"
"pacman:brightnessctl" = "latest"
"pacman:playerctl" = "latest"
"pacman:wireplumber" = "latest"
"pacman:wl-clipboard" = "latest"
"pacman:satty" = "latest"
"pacman:xclip" = "latest"
"pacman:flatpak" = "latest"
"pacman:cliphist" = "latest"
"pacman:wl-clip-persist" = "latest"
"pacman:libfido2" = "latest"
{{- end }}

[bootstrap.user]
login_shell = "{{ if eq .chezmoi.os "darwin" }}/bin/zsh{{ else }}/usr/bin/zsh{{ end }}"

[tasks.bootstrap]
run = [
  'test -f ~/.ssh/id_ed25519 || ssh-keygen -t ed25519 -N "" -f ~/.ssh/id_ed25519 -C ""',
{{- if eq .chezmoi.os "linux" }}
  'paru -S --needed --noconfirm noctalia vicinae-bin || true',
  'systemctl --user enable cliphist.service wl-clip-persist.service vicinae.service || true',
{{- end }}
  'chezmoi init roziscoding --apply',
{{- if eq .chezmoi.os "linux" }}
  'systemctl --user enable keyring-yubikey-unlock.service || true',
  'test -f ~/.local/share/keyring-yubikey/password.enc || ~/.local/bin/keyring-yubikey-enroll || true',
{{- end }}
]
