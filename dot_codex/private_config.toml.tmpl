personality = "pragmatic"
model = "gpt-5.6-sol"
model_reasoning_effort = "medium"
approvals_reviewer = "user"
approval_policy = "never"
sandbox_mode = "danger-full-access"
daybreak = true

[features]
cli_daybreak = true

[projects."{{ .chezmoi.homeDir }}"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/github.com/meistrari/auth-api"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/github.com/meistrari/pantry"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/github.com/meistrari/k8s-apps"]
trust_level = "trusted"

[projects."{{ .chezmoi.homeDir }}/github.com/meistrari/tela-local"]
trust_level = "trusted"

[tui]
status_line = [
  "model-with-reasoning",
  "current-dir",
  "git-branch",
  "permissions",
  "approval-mode",
  "context-remaining",
  "five-hour-limit",
  "weekly-limit",
  "fast-mode",
]
status_line_use_colors = true
screen_reader_detection_done = true

[tui.model_availability_nux]
"gpt-5.5" = 4
"gpt-5.6-sol" = 2
"gpt-6.1-sol" = 4

[mcp_servers.context7]
url = "https://mcp.context7.com/mcp"

[mcp_servers.context7.http_headers]
CONTEXT7_API_KEY = "{{ onepasswordRead "op://Private/Context7/API Key" "mafagafos.1password.com" }}"

[mcp_servers.pantry]
url = "https://pantry-api.tela.tools/mcp"
http_headers_helper = "tela mcp headers pantry"

[mcp_servers.node_repl]
args = []
command = "/opt/codex-desktop/resources/cua_node/bin/node_repl"
startup_timeout_sec = 120

[mcp_servers.node_repl.env]
NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS = "1000"
NODE_REPL_NODE_MODULE_DIRS = "/opt/codex-desktop/resources/cua_node/lib/node_modules"
NODE_REPL_NODE_PATH = "/opt/codex-desktop/resources/cua_node/bin/node"
NODE_REPL_TRUSTED_CODE_PATHS = "{{ .chezmoi.homeDir }}/.codex:/opt/codex-desktop/resources/cua_node/lib/node_modules"
CODEX_HOME = "{{ .chezmoi.homeDir }}/.codex"
BROWSER_USE_AVAILABLE_BACKENDS = "chrome,iab,mcpapps"
BROWSER_USE_TINYSKY_ENABLED = "1"
NODE_REPL_INSTRUCTIONS_USE_CASE_BROWSER = ""
NODE_REPL_INSTRUCTIONS_USE_CASE_CHROME = ""
BROWSER_USE_CODEX_APP_BUILD_FLAVOR = "prod"
BROWSER_USE_CODEX_APP_VERSION = "26.1013.40934"
NODE_REPL_TRUSTED_SERVICES = '{"browser":"{{ .chezmoi.homeDir }}/.codex/plugins/cache/openai-bundled/browser/26.1013.40934/scripts/browser-service.mjs","sky":"@oai/sky/service"}'
CODEX_CLI_PATH = "/opt/codex-desktop/resources/codex"
NODE_REPL_INSTRUCTIONS_USE_CASE_COMPUTER_USE = ""

[desktop]
followUpQueueMode = "steer"
selected-avatar-id = "pet_6ace45eb51d081919729ad8e890993a3"

[marketplaces.openai-bundled]
source_type = "local"
source = "{{ .chezmoi.homeDir }}/.codex/.tmp/bundled-marketplaces/openai-bundled"

[marketplaces.openai-primary-runtime]
source_type = "local"
source = "{{ .chezmoi.homeDir }}/.cache/codex-runtimes/codex-primary-runtime/plugins/openai-primary-runtime"

[plugins."browser@openai-bundled"]
enabled = true

[plugins."unified-computer-use@openai-bundled"]
enabled = true

[plugins."visualize@openai-bundled"]
enabled = true

[plugins."computer-use@openai-bundled"]
enabled = true

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."pdf@openai-primary-runtime"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."template-creator@openai-primary-runtime"]
